# ---- Firebase client (public, not secret) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Set to 1 locally to use the Firebase Emulator Suite (auth :9199, firestore :8180)
NEXT_PUBLIC_USE_EMULATORS=0

# ---- Server only ----
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the private key with literal \n sequences
FIREBASE_ADMIN_PRIVATE_KEY=
# Comma-separated allow-list of owner emails
OWNER_EMAILS=
# openssl rand -base64 32
KEY_ENCRYPTION_SECRET=
KEY_ENCRYPTION_VERSION=1
# openssl rand -base64 32
CAPTURE_TOKEN_PEPPER=
# none | r2
STORAGE_DRIVER=none
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# e.g. https://personalhub-xyz.vercel.app
APP_ORIGIN=http://localhost:3000
# Comma-separated Chrome extension ids allowed for CORS
EXTENSION_IDS=
# 1 = use the mock AI provider (local dev / e2e)
AI_MOCK=0
